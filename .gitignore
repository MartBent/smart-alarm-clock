# build artifacts (match anywhere in the tree)
target/
.embuild
/.vscode
*.log

# esp-idf generated config (sdkconfig.defaults IS tracked; the resolved
# sdkconfig and its backups are generated per-build)
software/firmware/sdkconfig
software/firmware/sdkconfig.old

# RustRover / IDEA: keep shared run configs (.run/) but ignore per-user state
/.idea

# Python bytecode (Home Assistant custom integration)
__pycache__/
*.pyc

# Playwright MCP browser session artifacts
.playwright-mcp/
**/.playwright-mcp/
